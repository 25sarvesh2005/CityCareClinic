# ─────────────────────────────────────────────────────────────
# CityCare Clinic — Environment Configuration Template (.env.example)
# ─────────────────────────────────────────────────────────────
# Copy this template to .env and fill in all values for your environment.
# NEVER commit your real .env file or real secrets to version control.
# ─────────────────────────────────────────────────────────────

# Application Environment (development, test, production)
APP_ENV=development

# MongoDB Configuration
MONGO_URL=mongodb://localhost:27017
DB_NAME=citycare_clinic

# JSON Web Token (JWT) Authentication
# In production, a cryptographically random secret string of at least 32 characters is required.
JWT_SECRET=your-secure-random-secret-key-at-least-32-characters-long
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Cross-Origin Resource Sharing (CORS)
# Comma-separated allowed origin URLs. In production, origins must explicitly use the https:// scheme.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Demo Account Seeding
# Set to true ONLY for initial development setup. Strictly forbidden and ignored in production.
SEED_DEMO_USERS=false
DOCTOR_EMAIL=dr.meera@citycare.com
DEMO_DOCTOR_PASSWORD=
DEMO_PATIENT_PASSWORD=
DEMO_ADMIN_PASSWORD=

# Telegram Patient Gateway
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_PUBLIC_WEBHOOK_URL=
TELEGRAM_API_BASE_URL=https://api.telegram.org

# AI & LLM Integrations (Google GenAI)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=10
PRESCRIPTION_AI_USE_GEMINI=true

# Storage & Persistence Paths
LOCAL_PRESCRIPTION_DIR=data/prescriptions
CHROMA_PERSIST_DIR=data/chroma_db

# Cloudinary Storage (Optional - falls back to local PDF storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Model Context Protocol (MCP) Server
CITYCARE_API_BASE_URL=http://127.0.0.1:8000
MCP_HOST=127.0.0.1
MCP_PORT=8001
MCP_TRANSPORT=streamable-http
CITYCARE_MCP_JWT=
